# Required ───────────────────────────────────────────────────────────────
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Optional (defaults shown) ──────────────────────────────────────────────
# Pin the model so dev runs == eval runs == prod runs (twelve-factor X).
OPENAI_MODEL=gpt-4o-2024-08-06

# Sampling temperature. 0.0 by default for determinism; bump only for
# explicit ablations.
OPENAI_TEMPERATURE=0.0

# Seed any eval-side sampling (fixture shuffle, gold-set ordering).
EVAL_SEED=42

# Threshold for the structured JSON logger.
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
